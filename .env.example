# Required: Postgres URL and the key that signs sign-in tokens (openssl rand -hex 32)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=your-secret-key-here

# App: environment (development, staging or production) and the port python -m app serves on
APP_ENV=development
PORT=8000

# Website: its address (invitation links, Paystack's return), the origins allowed to call the
# API (comma-separated), and the sign-in cookie's SameSite (lax; none when site and API are on
# different domains)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAMESITE=lax

# Logging: JSON lines in production; SENTRY_DSN reports errors (required in production)
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=

# Background jobs: true runs them inside the API when there is no worker (python -m app.worker)
RUN_JOBS_IN_WEB=false

# Optional keys: without OpenAI, plain recommendations and explanations are shown; without
# Paystack (the sk_test_ key outside production), payments answer 503
OPENAI_API_KEY=
PAYSTACK_SECRET_KEY=

# Tests only: a separate LOCAL database with "test" in its name, never DATABASE_URL
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/careerline_test
