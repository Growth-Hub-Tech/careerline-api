# Copy to .env and fill in. Every variable the code reads is listed here.

# --- Required ---
# Postgres connection (postgres://, postgresql:// and postgresql+asyncpg:// all work)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Signs login tokens (JWT). Use a long random value, e.g. `openssl rand -hex 32`
SECRET_KEY=your-secret-key-here

# --- App ---
APP_ENV=development
APP_NAME=CareerLine API
APP_PORT=8000
# Global prefix for every API route
API_PREFIX=/api/v1
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Refuse to start when the database is behind the latest migration
CHECK_MIGRATIONS_ON_STARTUP=true
# Sample answers for endpoints not built yet (unset = on everywhere except APP_ENV=production)
# SAMPLE_API_ENABLED=false
# Where the sample flows (checkout, invitations) keep their state
SAMPLE_STATE_FILE=/tmp/careerline-sample-state.json

# --- Logging ---
LOG_LEVEL=INFO
# true = one JSON object per line (production); false = readable console output
LOG_JSON=false

# --- OpenAI (optional: without a key a plain fallback recommendation is used) ---
OPENAI_API_KEY=your-key-here
OPENAI_TIMEOUT_SECONDS=30

# --- Background jobs (app/jobs) ---
# true = the API process runs the jobs itself (the free test server has no worker service);
# production runs `python -m app.worker` and leaves this false
RUN_JOBS_IN_WEB=false
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
JOB_BATCH_SIZE=5
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600

# --- Email (app/email) ---
# smtp | test_mailbox | console. Unset = smtp in production, test_mailbox on staging, console otherwise
# EMAIL_BACKEND=console
EMAIL_FROM=CareerLine <no-reply@careerline.local>
EMAIL_BRAND_NAME=CareerLine
# An https:// logo for the email header (empty = the brand name as text)
EMAIL_LOGO_URL=
# Contact form messages go here
SUPPORT_EMAIL=support@careerline.local
# Links in emails point to the website (it needs the pages /verify-email and /reset-password)
FRONTEND_URL=http://localhost:5173
# Only for EMAIL_BACKEND=smtp (any SMTP provider). SMTP_SECURITY: starttls (587), ssl (465), none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20
# When set, GET /api/v1/test-mailbox asks for it in the X-Test-Mailbox-Token header
TEST_MAILBOX_TOKEN=

# --- Accounts (Day 6) ---
# Confirmation links work once for this many hours; reset links once for this many minutes
VERIFY_EMAIL_TOKEN_HOURS=48
PASSWORD_RESET_TOKEN_MINUTES=60
# Failed sign-ins allowed per email and per IP address within the window, then 429
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
SIGNUPS_PER_IP_PER_HOUR=20

# --- Tests ---
# Only for pytest's database tests: a LOCAL database with "test" in its name, never the one above
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/careerline_test

# --- Question quality (Day 8; docs/question-quality.md) ---
# Correct option is the single longest and at least this many times the average wrong one:
# a review note / not served
QUESTION_LENGTH_REVIEW_RATIO=1.3
QUESTION_LENGTH_BLOCK_RATIO=2.0
# A skill can be tested only when every level has at least this many ACTIVE questions
MIN_ACTIVE_QUESTIONS_PER_LEVEL=15

# --- Assessment ---
PASS_THRESHOLD=60
WEAK_THRESHOLD=60
QUESTIONS_PER_LEVEL=25

# --- Server (read by scripts/start.sh; Render sets PORT itself) ---
# Load seeds/ after migrating, on every start (the test server sets it to true)
SEED_ON_START=false
# Load the demo accounts and demo company on every start (test server only; refused in production)
DEMO_DATA_ON_START=false
PORT=8000
WEB_CONCURRENCY=2
