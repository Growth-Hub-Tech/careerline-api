# dev and main only change through pull requests
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "dev" ] || [ "$branch" = "main" ]; then
  echo "✋ Direct commits to '$branch' are not allowed." >&2
  echo "   Create a branch (e.g. git switch -c feat/my-change) and open a pull request into dev." >&2
  exit 1
fi

# Lint and format the staged files (ruff for Python, Prettier for Markdown/JSON/YAML)
npx lint-staged

# Type-check the app
MYPY=mypy
[ -x .venv/bin/mypy ] && MYPY=.venv/bin/mypy
if ! command -v "$MYPY" >/dev/null 2>&1; then
  echo "mypy not found. Set up the virtualenv first: make install" >&2
  exit 1
fi
"$MYPY"
