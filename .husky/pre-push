# Branch names: type/description, e.g. feat/D01-BE-tests-and-secret-check (see COMMIT_CONVENTION.md)
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|chore|ci|revert)/[A-Za-z0-9._-]+$'

while read -r local_ref local_sha remote_ref remote_sha; do
  branch=${remote_ref#refs/heads/}

  # dev and main only change through pull requests
  if [ "$branch" = "dev" ] || [ "$branch" = "main" ]; then
    echo "✋ Pushing directly to '$branch' is not allowed. Push your branch and open a pull request." >&2
    exit 1
  fi

  # Deleting a remote branch sends an all-zero sha: no name check needed
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  case "$remote_ref" in
    refs/heads/*)
      if ! echo "$branch" | grep -qE "$PATTERN"; then
        echo "✋ Branch name '$branch' does not follow type/description (e.g. feat/user-login, fix/D02-BE-null-score)." >&2
        echo "   Valid types: feat, fix, docs, style, refactor, perf, test, build, chore, ci, revert" >&2
        exit 1
      fi
      ;;
  esac
done

# Run the test suite before anything leaves this machine
PYTEST=pytest
[ -x .venv/bin/pytest ] && PYTEST=.venv/bin/pytest
if ! command -v "$PYTEST" >/dev/null 2>&1; then
  echo "pytest not found. Set up the virtualenv first: make install" >&2
  exit 1
fi
"$PYTEST" -q
